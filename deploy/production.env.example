# Copie os valores para o ambiente da hospedagem. Nunca publique credenciais.
APP_ENV=production
SECRET_KEY=
DB_HOST=host-fornecido-pela-hospedagem
DB_PORT=3306
DB_USER=usuario_exclusivo_mentorly
DB_PASSWORD=
DB_NAME=nome_do_banco
DB_SSL_CA=
FRONTEND_URL=https://seu-dominio.com.br
CORS_ORIGINS=https://seu-dominio.com.br
TRUSTED_HOSTS=seu-dominio.com.br
# 1 somente se o servidor aceitar conexoes exclusivamente de um proxy confiavel.
TRUSTED_PROXY_HOPS=0
WEB_BUILD_DIR=/caminho/absoluto/Mentorly/frontend/app_mentorly/build/web
MAIL_SERVER=smtp.seu-provedor.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@seu-dominio.com.br
MAIL_USE_SSL=false
SMTP_TLS=1
MAIL_TIMEOUT=10
FLASK_DEBUG=false
DEV_EXPOSE_AUTH_CODES=false
BACKUP_KEY=
BACKUP_DIR=/caminho/privado/fora-da-pasta-publica/backups
BACKUP_RETENCAO=14
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
