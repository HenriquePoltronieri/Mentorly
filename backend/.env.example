# Copie para backend/.env (ignorado pelo Git) e preencha. Aqui ficam so nomes e
# padroes publicos: nunca coloque valores reais neste arquivo.

# Banco de dados (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mentorly_db

# Assinatura do JWT. Sem valor, o backend gera uma chave por execucao e as
# sessoes caem ao reiniciar. Defina antes de qualquer uso real.
SECRET_KEY=

# IA (Groq, compativel com chat completions)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT=15

# E-mail do convite de professor e do codigo de verificacao. Sem SMTP_HOST o
# e-mail NAO e enviado (e nada vaza na resposta da API).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@mentorly.local
SMTP_TLS=1
APP_BASE_URL=http://localhost:3000

# Desenvolvimento local (ambos desligados por padrao; nunca ligue em producao).
# FLASK_DEBUG: modo debug do Flask ao rodar `python app.py`.
# DEV_EXPOSE_AUTH_CODES: deixa a API devolver o codigo de verificacao e o token
# de convite do professor (e imprime o email no console quando nao ha SMTP).
FLASK_DEBUG=false
DEV_EXPOSE_AUTH_CODES=false
