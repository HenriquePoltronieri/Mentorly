SECRET_KEY=

AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT=15

# Desenvolvimento local (ambos desligados por padrao; nunca ligue em producao).
# FLASK_DEBUG: modo debug do Flask ao rodar `python app.py`.
# DEV_EXPOSE_AUTH_CODES: deixa a API devolver o codigo de verificacao e o token
# de convite do professor (e imprime o email no console quando nao ha SMTP).
FLASK_DEBUG=false
DEV_EXPOSE_AUTH_CODES=false
