# Copie para backend/.env (ignorado pelo Git) e preencha. Aqui ficam so nomes e
# padroes publicos: nunca coloque valores reais neste arquivo.

# Banco de dados (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mentorly_db

# Assinatura do JWT. Sem valor, o backend gera uma chave por execucao e as
# sessoes caem ao reiniciar. Defina antes de qualquer uso real.
SECRET_KEY=

# IA (Groq, compativel com chat completions)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT=15

# E-mail do convite e do código de verificação. Sem MAIL_SERVER o envio falha;
# a Coordenação pode copiar o link do convite e compartilhá-lo manualmente.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=mentorly.noreply@gmail.com
# Senha de app gerada pelo Google (não a senha normal da conta).
MAIL_PASSWORD=
MAIL_FROM=mentorly.noreply@gmail.com
MAIL_USE_SSL=false
MAIL_TIMEOUT=3
FRONTEND_URL=http://localhost:3000
CONVITE_EXPIRACAO_HORAS=48

# Desenvolvimento local (ambos desligados por padrao; nunca ligue em producao).
# FLASK_DEBUG: modo debug do Flask ao rodar `python app.py`.
# DEV_EXPOSE_AUTH_CODES: deixa a API devolver o codigo de verificacao e o token
# de convite do professor (e imprime o email no console quando nao ha SMTP).
FLASK_DEBUG=false
DEV_EXPOSE_AUTH_CODES=false

# Hospedagem: leia docs/hospedagem-e-acessos.md antes de mudar para production.
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=
TRUSTED_PROXY_HOPS=0
WEB_BUILD_DIR=
# Certificado CA, se o provedor exigir conexao MySQL com TLS.
DB_SSL_CA=

# O iniciador local cria a chave ausente sem exibi-la. Guarde uma copia segura.
BACKUP_KEY=
BACKUP_DIR=backups
BACKUP_RETENCAO=14
# Opcional quando mysqldump nao estiver no PATH.
MYSQLDUMP_PATH=
